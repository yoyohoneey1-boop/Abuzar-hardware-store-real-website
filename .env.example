# Shopify Admin > Settings / Headless channel: use your shop's myshopify.com domain.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Optional public Storefront API token. If using tokenless Storefront API, leave blank.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-04

# Optional: set this server-side key to enable AI-generated answers.
# Without it, the chatbot uses built-in Pakistan-focused FAQ responses.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
